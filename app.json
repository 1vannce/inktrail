{
  "expo": {
    "name": "InkTrail",
    "slug": "inktrail",
    "scheme": "inktrail",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inktrail.reader"
    },
    "android": {
      "package": "com.inktrail.reader"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "InkTrail"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
