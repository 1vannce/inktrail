{
  "expo": {
    "name": "PanelPaw",
    "slug": "panelpaw",
    "scheme": "panelpaw",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inktrail.reader"
    },
    "android": {
      "package": "com.inktrail.reader"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "PanelPaw",
      "favicon": "./assets/branding/panelpaw-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "icon": "./assets/branding/panelpaw-icon.png"
  }
}
